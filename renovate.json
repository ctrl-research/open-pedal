{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Toronto",
  "rebaseWhen": "conflicted",
  "commitBodyTable": true,
  "printConfig": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "enabledManagers": [
    "asdf",
    "github-actions",
    "custom.regex"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "asdf"
      ],
      "commitMessageTopic": "tool {{depName}}",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "tools",
      "addLabels": [
        "tools"
      ]
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "commitMessageTopic": "dependency {{depName}}",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "addLabels": [
        "deps"
      ]
    },
    {
      "matchDatasources": [
        "github-actions"
      ],
      "commitMessageTopic": "github action {{depName}}",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci",
      "addLabels": [
        "ci"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "patch"
      ]
    }
  ],
  "labels": [
    "renovate"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "CMake FetchContent pins in cmake/Dependencies.cmake",
      "managerFilePatterns": [
        "/^cmake/Dependencies\\.cmake$/"
      ],
      "matchStrings": [
        "GIT_TAG\\s+(?<currentValue>\\S+)\\s+# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "pluginval release used in CI",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "PLUGINVAL_VERSION:\\s+(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "Tracktion/pluginval",
      "datasourceTemplate": "github-releases"
    }
  ]
}
