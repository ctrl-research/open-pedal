{
  "schema": 1,
  "id": "openpedal.digital-delay",
  "name": "Digital Delay",
  "version": "1.0.0",
  "category": "delay",
  "author": "OpenPedal",
  "description": "Clean digital delay with a damping filter in the feedback path so repeats get darker as they fade.",
  "tail_seconds": 6,
  "knobs": [
    { "id": "time", "name": "Time", "type": "float", "min": 20, "max": 1500, "default": 380, "unit": "ms", "taper": "log", "smoothing_ms": 80 },
    { "id": "feedback", "name": "Feedback", "type": "float", "min": 0, "max": 0.95, "default": 0.35 },
    { "id": "damping", "name": "Damping", "type": "float", "min": 1000, "max": 12000, "default": 4000, "unit": "Hz", "taper": "log" },
    { "id": "mix", "name": "Mix", "type": "float", "min": 0, "max": 1, "default": 0.3, "taper": "audio" }
  ],
  "nodes": [
    { "id": "dly", "type": "delay", "time_ms": { "knob": "time" }, "max_ms": 1600 },
    { "id": "damp", "type": "filter", "mode": "lowpass", "cutoff": { "knob": "damping" }, "q": 0.5 },
    { "id": "fb", "type": "gain", "gain": { "knob": "feedback" } },
    { "id": "blend", "type": "mix", "mix": { "knob": "mix" } }
  ],
  "connections": [
    ["in", "dly"],
    ["dly", "damp"],
    ["damp", "fb"],
    ["fb", "dly"],
    ["in", "blend.a"],
    ["damp", "blend.b"],
    ["blend", "output"]
  ]
}
